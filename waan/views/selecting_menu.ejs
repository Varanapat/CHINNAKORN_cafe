<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHINNAKORN CAFÉ</title>
    <link rel="stylesheet" href="/style_main.css">
    <link rel="stylesheet" href="/style_modal.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body>
    <!-- header -->
    <header>
        <a href="/" class="logo">CHINNAKORN café</a>
        <nav>
            <% cate.forEach(item => { %>
                <a href="#<%= item.category_id %>" class="<%= item.category_id == activeCateId ? 'active' : '' %>">
                    <%= item.category_name %>
                </a>
                <% }) %>
                    <a href="/cart" class="cart">CART (<span id="cart-count">0</span>)</a>
        </nav>
    </header>

    <!-- main content + sidebar -->
    <div class="main-container">
        <div class="left">
            <% cate.forEach(category=> { %>
                <section id="<%= category.category_id %>" class="category-section">
                    <!-- หัวข้อหมวดหมู่ -->
                    <h2 class="category-title">
                        <%= category.category_name %>
                    </h2>

                    <!-- รายการเมนู -->
                    <div class="menu-container">
                        <% menu.filter(item_menu=> item_menu.category_id === category.category_id)
                    .forEach(item_menu => { %>

                            <a class="menu" data-modal-target="#modal-<%= item_menu.menu_id %>">
                                <div class="menu-card">
                                    <img class="menu-img" src="/picture/<%= item_menu.menu_image %>" alt="<%= item_menu.menu_name %>">
                                    <h3 class="menu-name">
                                        <span>
                                    <%= item_menu.menu_name %>
                                </span>
                                        <span>
                                    <%= item_menu.base_price %> ฿
                                </span>
                                    </h3>
                                </div>
                            </a>

                            <div class="modal" id="modal-<%= item_menu.menu_id %>">
                                <div class="modal-header">
                                    <div class="title">
                                        <%= item_menu.menu_name %>
                                    </div>
                                    <button data-close-button class="close-button">&times;</button>
                                </div>

                                <div class="modal-body">
                                    <div class="container_menu">
                                        <!-- ฝั่งซ้าย -->
                                        <div class="container_left">
                                            <img class="img" src="/picture/<%= item_menu.menu_image %>" alt="<%= item_menu.menu_name %>">
                                        </div>

                                        <!-- ฝั่งขวา -->
                                        <div class="container_right">
                                            <div class="head_container_right">
                                                <b>รายละเอียดของเมนู: </b>
                                                <p class="menu-description">
                                                    <%= item_menu.description %>
                                                </p>
                                            </div>

                                            <!-- ส่วนเลือก option -->
                                            <!-- <form> -->
                                            <form method="post" action="/add-to-cart" class="cart-form" data-menu-id="<%= item_menu.menu_id %>">
                                                <div class="form">

                                                    <% slt.forEach(sl=> { %>
                                                        <% if (item_menu.menu_id===sl.menu_id) { %>
                                                            <div class="option_selector">
                                                                <fieldset>
                                                                    <legend>
                                                                        <% if (sl.is_required === 1) { %>
                                                                            <span> <b style="color: #ff1414;"><%= sl.group_name %> *****</b></span>
                                                                            <%}else {%>
                                                                                <span> <%= sl.group_name %></span>
                                                                                <%} %>
                                                                    </legend>
                                                                    <% itslt.forEach(itsl=> { %>
                                                                        <% if (sl.group_name===itsl.group_name) { %>
                                                                            <div class="option_container">
                                                                                <div class="option_left">
                                                                                    <% if (sl.is_required === 1) { %>
                                                                                        <input type="radio" name="menu-<%= item_menu.menu_id %>-<%= itsl.group_name %>" value="<%= itsl.option_name %>" id="opt-<%= item_menu.menu_id %>-<%= itsl.option_name %>" required />
                                                                                        <%} else {%>
                                                                                            <input type="radio" name="menu-<%= item_menu.menu_id %>-<%= itsl.group_name %>" value="<%= itsl.option_name %>" id="opt-<%= item_menu.menu_id %>-<%= itsl.option_name %>" />
                                                                                            <%} %>
                                                                                                <label for="opt-<%= item_menu.menu_id %>-<%= itsl.option_name %>">
                                                                                <%= itsl.option_name %>
                                                                            </label>
                                                                                </div>
                                                                                <span>
                                                                            <% if (itsl.extra_price===0) { %>
                                                                                (ฟรี)
                                                                                <% } else { %>
                                                                                    (+ <%= itsl.extra_price %> ฿)
                                                                                        <% } %>
                                                                        </span>
                                                                            </div>
                                                                            <% } %>
                                                                                <% }) %>
                                                                </fieldset>
                                                            </div>
                                                            <% } %>
                                                                <% }) %>

                                                </div>

                                                <!-- ส่วนด้านล่าง -->
                                                <div class="bottom_container_right">
                                                    <div class="price-container">
                                                        <p class="price" data-base-price="<%= item_menu.base_price %>">
                                                            <%= item_menu.base_price %> ฿
                                                        </p>
                                                        <div class="selected-options"></div>
                                                    </div>

                                                    <!-- ปุ่มเพิ่ม/ลดจำนวน -->
                                                    <div class="quantity">
                                                        <button type="button" class="qty-btn minus">&minus;</button>
                                                        <span class="qty">1</span>
                                                        <button type="button" class="qty-btn plus">&plus;</button>
                                                    </div>

                                                    <!-- hidden fields -->
                                                    <input type="hidden" name="quantity" value="1">
                                                    <input type="hidden" name="options" value="">
                                                    <input type="hidden" name="totalPrice" value="">

                                                    <button type="submit" class="add-to-cart">เพิ่มลงตะกร้า</button>
                                                </div>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </section>
                <% }) %>
        </div>



        <!-- ฝั่งขวา-->
        <div class="right">
            <!-- ปุ่มเลือกทานที่ร้าน / กลับบ้าน -->
            <div class="order-type">
                <button type="button" class="order-btn" id="dine-in"><i class="bi bi-shop"></i> ทานที่ร้าน</button>
                <button type="button" class="order-btn" id="take-away"><i class="bi bi-house-fill"></i> กลับบ้าน</button>
            </div>
            <script>
                async function selectType(type) {
                    const res = await fetch('/order-type', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            orderType: type
                        })
                    });
                    const data = await res.json();
                    if (data.success) window.location.href = '/category';
                }

                document.addEventListener("DOMContentLoaded", () => {
                    document.getElementById("dine-in").addEventListener("click", () => selectType("dine-in"));
                    document.getElementById("take-away").addEventListener("click", () => selectType("take-away"));
                });
            </script>

            <!-- เส้น -->
            <hr>

            <!-- คลังสินค้า -->
            <!-- คลังสินค้า -->
            <div class="inventory">
                <h3>คลังสินค้า</h3>
                <button type="button" id="inventory"><i class="bi bi-box-seam-fill"></i></button>
            </div>
            <script>
                document.getElementById('inventory').addEventListener('click', function() {
                    window.location.href = '/inventory';
                });
            </script>
        </div>


        <div id="overlay"></div>

        <!-- scripts -->
        <script src="/script_main.js"></script>
        <script src="/script_add_to_cart.js"></script>
        <script src="/script_modal.js"></script>
</body>

</html>
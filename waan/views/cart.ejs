<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <link rel="stylesheet" href="/style_cart.css">
</head>

<body data-total="<%= total %>">
    <div class="container">
        <!-- Header -->
        <div class="header">
            <button class="back-btn" onclick="window.history.back()">←</button>
            <h1>สรุปรายการ (
                <%= cart.length %> รายการ )</h1>
        </div>

        <div class="content">
            <!-- ============= ฝั่งซ้าย: รายการในตะกร้า ============= -->
            <div class="left-section">
                <div class="tabs">
                    <button class="tab active">เมนู</button>
                    <button class="tab">ราคารายการย่อย</button>
                </div>

                <% if (cart.length === 0) { %>
                    <p>ยังไม่มีสินค้าในตะกร้า</p>
                    <% } else { %>
                        <div id="cart-list">
                            <% cart.forEach((item, index) => { %>
                                <div class="cart-item" data-menu-id="<%= item.menu_id %>">
                                    <img src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                                    <div class="item-details">
                                        <div class="item-name">
                                            <%= item.menu_name %>
                                        </div>
                                        <% if (item.options && item.options.length > 0) { %>
                                            <% item.options.forEach(opt => { %>
                                                <div class="item-options">
                                                    •
                                                    <%= opt.name %>
                                                        <% if (opt.extra && opt.extra > 0) { %>
                                                            (
                                                            <%= opt.extra %> ฿ )
                                                                <% } %>
                                                </div>
                                                <% }) %>
                                                    <% } %>
                                    </div>
                                    <div class="item-price">
                                        <%= item.totalPrice_forMenu %> ฿</div>
                                </div>
                                <% }) %>
                        </div>

                        <!-- สรุปยอด -->
                        <div class="summary">
                            <div class="summary-row">
                                <span>ยอดรวม :</span>
                                <span>฿ <%= (total / 1.07).toFixed(2) %></span>
                            </div>
                            <div class="summary-row">
                                <span>VAT 7% :</span>
                                <span>฿ <%= (total - (total / 1.07)).toFixed(2) %></span>
                            </div>
                            <div class="summary-row total">
                                <span>ยอดรวม :</span>
                                <span>฿ <%= total %></span>
                            </div>
                        </div>
                        <% } %>
            </div>

            <!-- ฝั่งขวา: เลือกชำระเงิน -->
            <div class="right-section">
                <div class="section-title">วิธีการชำระเงิน</div>
                <div class="payment-options">
                    <button class="payment-btn" data-payment="cash">เงินสด</button>
                    <button class="payment-btn selected" data-payment="qr">QR พร้อมเพย์</button>
                </div>

                <!-- แสดงเฉพาะเมื่อเลือกเงินสด -->
                <div id="cash-section" style="display: none;">
                    <div class="section-title">ชำระ (
                        <%= total %>)</div>
                    <div class="tip-options">
                        <button class="tip-btn" data-amount="<%= total %>"><%= total %></button>
                        <button class="tip-btn" data-amount="<%= Math.ceil(total / 100) * 100 %>"><%= Math.ceil(total / 100) * 100 %></button>
                        <button class="tip-btn" data-amount="500">500</button>
                        <button class="tip-btn" data-amount="1000">1000</button>
                    </div>

                    <div>
                        <label>ระบุจำนวนเงิน:</label>
                        <input type="number" id="custom-amount" placeholder="ระบุจำนวนเงิน">
                    </div>

                    <div id="change-display">
                        <div>
                            เงินทอน: <span id="change-amount">0</span> ฿
                        </div>
                    </div>
                    <br>
                </div>

                <!-- แสดงเฉพาะเมื่อเลือก QR -->
                <div id="qr-section">
                    <div class="qr-wrapper">
                        <p>ยอดชำระ: <strong><%= total %> ฿</strong></p>
                        <div id="qr-code-container">
                            <p>กด "ยืนยันชำระเงิน" เพื่อสร้าง QR Code</p>
                        </div>
                    </div>
                </div>

                <button class="confirm-btn" onclick="handleCheckout()">ยืนยันชำระเงิน</button>
            </div>
        </div>
    </div>

    <script src="/script_payment.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>คลังสินค้า - Inventory</title>
    <link rel="stylesheet" href="/style_inventory.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>

<body>
    <div class="container">
        <!-- Header Section -->
        <div class="header">
            <div class="inventory-icon">
                <button class="back-btn" onclick="window.history.back()">←</button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Left Column -->
            <div class="product-section">
                <h2 class="section-title">คลังสินค้า</h2>

                <!-- Search & Category -->
                <div class="search-bar">
                    <button class="category-btn active" data-category="drinks">เครื่องดื่ม</button>
                    <button class="category-btn" data-category="bakery">เบเกอรี่</button>
                </div>

                <!-- Drinks Section -->
                <div id="drinks-section" class="product-grid">
                    <% if (drinks && drinks.length > 0) { %>
                        <% drinks.forEach(item => { %>
                            <div class="product-card" onclick="selectItem('<%= item.menu_id %>', '<%= item.menu_name %>', 'drink', <%= item.is_available %>, <%= item.stock_qty || 0 %>)">
                                <img src="/picture/<%= item.menu_image || 'no_image.png' %>" alt="<%= item.menu_name %>">
                                <div class="product-name">
                                    <%= item.menu_name %>
                                </div>
                                <div class="price">
                                    <%= item.base_price %> ฿</div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="no-products">ไม่มีข้อมูลเครื่องดื่ม</div>
                                    <% } %>
                </div>

                <!-- Bakery Section -->
                <div id="bakery-section" class="product-grid" style="display: none;">
                    <% if (bakery && bakery.length > 0) { %>
                        <% bakery.forEach(item => { %>
                            <div class="product-card" onclick="selectItem('<%= item.menu_id %>', '<%= item.menu_name %>', 'bakery', <%= item.is_available %>, <%= item.stock_qty || 0 %>)">
                                <img src="/picture/<%= item.menu_image || 'no_image.png' %>" alt="<%= item.menu_name %>">
                                <div class="product-name">
                                    <%= item.menu_name %>
                                </div>
                                <div class="price">
                                    <%= item.base_price %> ฿</div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="no-products">ไม่มีข้อมูลเบเกอรี่</div>
                                    <% } %>
                </div>
            </div>

            <!-- Right Column -->
            <div class="selected-section">
                <h3 class="selected-title">รายการที่เลือก</h3>
                <div class="selected-items" id="selectedItems">
                    <div class="empty-state">
                        <p>กรุณาเลือกสินค้า</p>
                    </div>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-cancel" onclick="clearSelection()">ยกเลิก</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/script_inventory.js"></script>
</body>

</html>
// ส่งข้อมูลไป backend ด้วย fetch
document.getElementById('popup-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type="submit"]');
  btn.disabled = true;
  try {
    const fd = new FormData(e.target);
    const body = new URLSearchParams([...fd.entries()]).toString();
    const res = await fetch('/add_to_cart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
      body
    });
    if (!res.ok) throw new Error('Server error: ' + res.status);
    const result = await res.json();
    alert(result.message || 'สำเร็จ');
    closePopup();
  } catch (err) {
    console.error(err);
    alert('เกิดข้อผิดพลาด: ' + err.message);
  } finally {
    btn.disabled = false;
  }
});
</script>



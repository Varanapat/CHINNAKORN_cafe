            </a>
        </div>
        <% }); %>
     </div> -->
        <!-- content 3 -->
        <div class="container">
            <% menu.forEach(item=> { %>
                <!-- ปุ่มเปิด modal -->
                <a class="menu" data-modal-target="#modal-<%= item.menu_id %>">
                    <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                    <h3>
                        <%= item.menu_name %>
                    </h3>
                </a>

                <!-- modal ของแต่ละเมนู -->
                <div class="modal" id="modal-<%= item.menu_id %>">

                    <div class="modal-header">
                        <div class="title">
                            <%= item.menu_name %>
                        </div>
                        <button data-close-button class="close-button">&times;</button>
                    </div>

                    <div class="modal-body">
                        <div class="container_menu">
                            <!-- ฝั่งซ้าย ของหน้า modal -->
                            <div class="container_left">
                                <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                            </div>


                            <!-- ฝั่งขวา ของหน้า modal -->
                             <!-- ส่วนด้านบน - ทำให้มันไม่ขยับ -->
                            <div class="container_right">
                                <div class="head_container_right">
                                    <b>รายละเอียดของเมนู: </b>
                                    <p class="menu-description"><%= item.description %></p>
                                </div>

                                <!-- ส่วนให้เลือกตัวเลือก - ทำเป็น scroll ได้ -->
                                <form>
                                    <!-- <% slt.forEach(sl => { %> <% if (item.menu_id === sl.menu_id) { %> <p><%= sl.group_name %></p> <% } %> <% }) %> -->
                                    <% slt.forEach(sl=> { %> 
                                        <% if (item.menu_id===sl.menu_id) { %>
                                            <div class="option_selector">

                                                <!-- ช่องให้เลือก option ถ้ามี -->
                                                <fieldset>
                                                    <legend>
                                                        <%= sl.group_name %>
                                                    </legend>
                                                    <% itslt.forEach(itsl=> { %> 
                                                        <% if (sl.group_name===itsl.group_name) { %>
                                                            <!-- มีให้เลือก option group เเล้ว ดูว่ามีอะไรให้เลือกได้บ้าง -->
                                                            <div class="option_container">
                                                                <!-- พยายามเเบ่งซ้ายขวา -->
                                                                <div class="option_left"> 
                                                                    <input type="radio"
                                                                        name="menu-<%= item.menu_id %>-<%= itsl.group_name %>"
                                                                        value="<%= itsl.option_name %>"
                                                                        id="opt-<%= item.menu_id %>-<%= itsl.option_name %>" /> 
                                                                    <label for="opt-<%= item.menu_id %>-<%= itsl.option_name %>">
                                                                        <%= itsl.option_name %>
                                                                    </label> 
                                                                </div> 
                                                                <span>
                                                                    <% if (itsl.extra_price===0) { %> (ฟรี) <% } else { %> (+ <%=
                                                                        itsl.extra_price %> ฿) <% } %>
                                                                </span>
                                                            </div>
                                                        <% } %>
                                                    <% }) %>
                                                </fieldset>
                                            </div>
                                            <% } %>
                                    <% }) %>
                                </form>

                                <!-- ส่วนด้านล่าง -->

                                <div class="bottom_container_right"> 
                                    <div class="price-container">
                                        <p class="price" data-base-price="<%= item.base_price %>">
                                            <%= item.base_price %> ฿
                                        </p>
                                        <div class="selected-options"></div> <!-- จะมาแสดง option ที่เลือก -->
                                    </div>

                                    <div class="quantity">
                                        <button type="button" class="qty-btn minus">&minus;</button>
                                        <span class="qty">1</span>
                                        <button type="button" class="qty-btn plus">&plus;</button>
                                    </div>
                                    <button name="submit" class="add-to-cart">เพิ่มลงตะกร้า</button>
                                </div>
                

                            </div>

                        </div>
                    </div>
                </div>
                <!-- เเค่อยากรู้ว่า หน้าเปิดมันกิน บรรทัดไปเท่าไหร่ -->
                <% }) %>
        </div>
        <!-- overlay มีแค่หนึ่งอัน -->
        <div id="overlay"></div>
        <!-- script -->
        <script src="/script_modal.js"></script>
        <script src="/script_quantity.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chinakorn Cafe</title>
  <link rel="shortcut icon" href="/pictures/logo.PNG" type="image/x-icon">
  <link rel="stylesheet" href="/bootstrap.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Unicase:wght@300;400;500;600;700&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/style_main.css">
  <link rel="stylesheet" href="/style_modal.css">
  <link rel="stylesheet" href="/style_main_for_customer.css">
  <script src="/script_cart.js"></script>
  <script src="/script_modal.js"></script>
  <script src="/script_modal_cart.js"></script>
  <script src="/script_main.js"></script>
  <script src="/script_add_to_cart.js"></script>
</head>

<style>
  ul {
    list-style-type: none;  /* เอาจุดออก */
    padding-left: 0;        /* ลบระยะห่างซ้าย */
    margin: 0;             /* (ถ้าต้องการลบช่องว่างบนล่าง) */ 
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    padding-bottom: 3%;
  }

  .my-btn {
    padding: 14px;
    border: none;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
  }

  .my-btn-cancel {
    background: whitesmoke;
    color: gray;
  }
  .my-btn-cancel:hover {
    background: lightgrey;
  }

  .my-btn-confirm {
    background: #5682b1;
    color: white;
  }
  .my-btn-confirm:hover {
    background: lightblue;
  }
</style>

<body>
  <div class="content">
    <%- include('selecting_menu') %>
  </div>

  <!-- ตะกร้า -->
<div class="cart-icon" id="cart-icon" style="margin-top: 45%;">🛒</div>

<div class="modal" id="cart-modal">
  <div class="modal-content">
    <span class="close-btn" style="padding-left: 96%; padding-top: 2%;" id="close-modal">&times;</span>
    <h2 class="text-center py-3">ตะกร้าสินค้า</h2>
        <% if (cart.length === 0) { %>
            <p class="text-center py-3">!! ยังไม่มีสินค้าในตะกร้า !!</p>
        <% } else { %>
            <ul id="cart-list" class="mx-5">
                <% cart.forEach((item) => { %>
                    <li data-menu-id="<%= item.menu_id %>" data-options='<%= JSON.stringify(item.options) %>' style="border-bottom: solid 1px black;" class="py-3">
                        <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                        <strong><%= item.menu_name %></strong><br>
                        จำนวน: 
                        <button type="button" class="qty-btn minus btn">&minus;</button>
                        <span class="qty"><%= item.quantity %></span>
                        <button type="button" class="qty-btn plus btn">&plus;</button>
                        | ราคา/ชิ้น: <%= item.unitPrice %> | รวม: <span class="totalPrice"><%= item.totalPrice_forMenu %></span>
                        <br>
                        ตัวเลือก: 
                        <%= item.options.map(opt => opt.name + (opt.extra && opt.extra > 0 ? ` (+${opt.extra})` : "")).join(" | ") %>
                    </li>
                <% }) %>
            </ul>
        <% } %>
        <div class="action-buttons">
          <a href="/canceled_order-customer">
            <button class="my-btn my-btn-cancel">ยกเลิกคำสั่งซื้อ</button>
          </a>
          <a href="/confirm_order-customer" class="pl-3">
            <button class="my-btn my-btn-confirm">ยืนยันคำสั่งซื้อ</button>
          </a>
        </div>
  </div>
</div>

  <!-- overlay -->
  <div id="overlay"></div>
</body>
</html>

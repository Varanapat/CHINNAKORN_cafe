<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>merge ejs</title>
  <link rel="stylesheet" href="/style_merge.css">
  <link rel="stylesheet" href="/style_modal.css">
  <link rel="stylesheet" href="/bootstrap.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Unicase:wght@300;400;500;600;700&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
    rel="stylesheet">
  <style>
    * {
      font-family: 'Kodchasan', sans-serif;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0);
      /* โปร่งใส */
      pointer-events: none;
      /* ปิดการกด */
    }

    .action-buttons {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
    }

    .my-btn {
      padding: 14px;
      border: none;
      border-radius: 10px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s;
    }

    .my-btn-cancel {
      background: whitesmoke;
      color: gray;
    }

    .my-btn-cancel:hover {
      background: lightgrey;
    }

    .my-btn-confirm {
      background: #5682b1;
      color: white;
    }

    .my-btn-confirm:hover {
      background: lightblue;
    }

    .locked {
      pointer-events: none;
      /* ❌ ปิดการคลิกทั้งหมด */
      opacity: 0.5;
      /* ทำให้ดูจาง เหมือนถูกล็อก */
      cursor: not-allowed;
      /* แสดงเคอร์เซอร์ห้าม */
    }
  </style>
</head>

<body>
  <div class="content">
    <div class="container_1 locked">
      <%- include('selecting_menu') %>
    </div>
    <div class="container_2">
      <div class="mt-5">
        <a href="/main_cas/DINE_IN" style="outline: none;
                  text-decoration: none;"><button class="my-btn action-buttons my-btn-confirm"
            style="width: 50%; margin-left: 25%;"">ทานที่ร้าน</button></a>
              <a href=" /main_cas/TAKEAWAY" style="outline: none;
                  text-decoration: none;"><button class="my-btn action-buttons my-btn-confirm"
              style="width: 50%; margin-left: 25%;">กลับบ้าน</button></a>
      </div>
      <div style="
                    padding-top: 20px;
                    padding-right: 20px;
                    text-align: center;" class="mb-5">

        <!-- เส้นขอบไม่เต็ม -->
        <div style="border-top: 1px solid #483434; width: 50%; margin: 0 auto;"></div>

        <a href="/inventory_for_cashier" style="outline: none;
                        text-decoration: none; display: inline-block; margin-top: 20px;">
          <img style="width: 40%; height: auto; padding-bottom: 10px;" src="/pictures/package-box.png" alt="">
          <h6 style="color: #483434">คลังสินค้า</h6>
        </a>
      </div>
    </div>
  </div>
  <script src="/script_cart.js"></script>
  <script src="/script_modal.js"></script>
  <script src="/script_main.js"></script>
  <script src="/script_add_to_cart.js"></script>
  <!-- <script src="/script_add_to_cart.js"></script> -->
</body>

</html>
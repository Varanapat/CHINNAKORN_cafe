<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chinakorn Cafe</title>
  <link rel="shortcut icon" href="/pictures/logo.PNG" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Unicase:wght@300;400;500;600;700&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/style_main.css">
  <link rel="stylesheet" href="/style_modal_cashier.css">
  <link rel="stylesheet" href="/style_main_for_customer.css">

  <style>
    * {
      font-family: 'Kodchasan', sans-serif;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #FBF8F1;
    }

    .page-layout {
      display: grid;
      grid-template-columns: 2fr 1fr; /* ซ้าย 2 ส่วน ขวา 1 ส่วน */
      height: 100vh;
    }

    .menu-section {
      overflow-y: auto;
    }

    .cart-section {
      background-color: white;
      border-left: 3px solid #ddd;
      padding: 20px;
      overflow-y: auto;
      box-shadow: -2px 0 5px rgba(0,0,0,0.05);
    }

    .cart-section h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    .action-buttons {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      padding-bottom: 3%;
    }

    .my-btn {
      padding: 14px;
      border: none;
      border-radius: 10px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s;
    }

    .my-btn-cancel {
      background: whitesmoke;
      color: gray;
    }
    .my-btn-cancel:hover {
      background: lightgrey;
    }

    .my-btn-confirm {
      background: #5682b1;
      color: white;
    }
    .my-btn-confirm:hover {
      background: lightblue;
    }

    ul {
      list-style-type: none;
      padding-left: 0;
      margin: 0;
    }

    li {
      border-bottom: solid 1px black;
      padding: 12px 0;
    }

    .qty-btn {
      background: #eee;
      border: none;
      border-radius: 5px;
      padding: 5px 10px;
      margin: 0 5px;
      cursor: pointer;
      font-weight: bold;
    }

    .qty-btn:hover {
      background: #ccc;
    }

    .img {
      height: 50px;
      width: 50px;
      object-fit: cover;
      border-radius: 5px;
      margin-right: 10px;
    }

  </style>
</head>

<body>
  <div class="page-layout">

    <!-- 🥤 เมนูทางซ้าย -->
    <div class="menu-section">
      <%- include('selecting_menu_cashier') %>
    </div>

    <!-- 🛒 ตะกร้าทางขวา -->
    <div class="cart-section">
      <h2>ตะกร้าสินค้า</h2>

      <% if (cart.length === 0) { %>
        <p class="text-center" style="color: red; text-align: center;">!! ยังไม่มีสินค้าในตะกร้า !!</p>
      <% } else { %>
        <ul id="cart-list">
          <% cart.forEach((item) => { %>
            <li data-menu-id="<%= item.menu_id %>" data-options='<%= JSON.stringify(item.options) %>'>
              <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
              <strong><%= item.menu_name %></strong><br>
              จำนวน: 
              <button type="button" class="qty-btn minus">&minus;</button>
              <span class="qty"><%= item.quantity %></span>
              <button type="button" class="qty-btn plus">&plus;</button>
              | ราคา/ชิ้น: <%= item.unitPrice %> | รวม: 
              <span class="totalPrice"><%= item.totalPrice_forMenu %></span><br>
              ตัวเลือก: 
              <%= item.options.map(opt => opt.name + (opt.extra && opt.extra > 0 ? ` (+${opt.extra})` : "")).join(" | ") %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <div class="action-buttons">
        <a href="/canceled_order">
          <button class="my-btn my-btn-cancel">ยกเลิกคำสั่งซื้อ</button>
        </a>
        <a href="/confirm_order">
          <button class="my-btn my-btn-confirm">ยืนยันคำสั่งซื้อ</button>
        </a>
      </div>
    </div>
  </div>
  <script src="/script_cart.js"></script>
  <script src="/script_modal.js"></script>
  <script src="/script_modal_cart.js"></script>
  <script src="/script_main.js"></script>
  <script src="/script_add_to_cart.js"></script>
</body>
</html>

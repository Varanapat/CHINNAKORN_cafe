<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สรุปรายการ</title>
  <link rel="stylesheet" href="/style_confirm_order_customer.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Unicase:wght@300;400;500;600;700&family=Kodchasan:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/bootstrap.css">


</head>

<style>
  body {
    font-family: kodchasan !important;
  }

  .my-btn {
    padding: 14px;
    border: none;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
  }

  .my-btn-cancel {
    background: whitesmoke;
    color: gray;
  }

  .my-btn-cancel:hover {
    background: lightgrey;
  }

  .my-btn-confirm {
    background: #5682b1;
    color: white;
  }

  .my-btn-confirm:hover {
    background: lightblue;
  }
</style>

<body>
  <div class="header">
    <a style="text-decoration: none; outline: none; color: #111827;" href="/main_for_customer">
      <h1>&#11013;</h1>
    </a>
    <h2>สรุปรายการ ( <%= cart.length %> รายการ )</h2>
  </div>

  <div class="container">

    <!-- สรุปรายการฝั่งซ้าย -->
    <div class="order-summary">
      <% cart.forEach(item=> { %>
        <div class="menu-item">
          <img src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
          <div class="details">
            <div class="name_order">
              <div class="name">
                <h3>
                  <%= item.menu_name %>
                </h3>
              </div>
              <div class="quantity">
                <%= item.quantity %> X
              </div>
            </div>

            <ul>
              <% if (item.options && item.options.length> 0) { %>
                <% item.options.forEach(opt=> { %>
                  <li>
                    <%= opt.name %>
                      <%= opt.extra && opt.extra> 0 ? ` (+${opt.extra})` : "" %>
                  </li>
                  <% }) %>
                    <% } %>
            </ul>

            <div class="price">
              <%= item.totalPrice_forMenu %> ฿
            </div>
          </div>
        </div>
        <% }) %>
          <% let beforeVAT=(total * 100) / 107; let vat=total - beforeVAT; %>


            <div class="total-box_not-final">
              <span>ยอดรวมก่อน vat :</span>
              <span>
                <%= beforeVAT.toFixed(2) %> ฿
              </span>
            </div>
            <div class="total-box_not-final">
              <span>vat :</span>
              <span>
                <%= vat.toFixed(2) %> ฿
              </span>
            </div>




            <div class="total-box">
              <span>ยอดรวม :</span>
              <span id="total-display">
                <%= total %> ฿
              </span>

            </div>
    </div>

    <!-- ฝั่งขวา วิธีการชำระเงิน -->
    <div class="payment">
      <h3 style="padding-bottom: 5%; padding-left: 3%;">วิธีการชำระเงิน</h3>
      <div class="pay-buttons pb-5 pl-3">
        <a class="qr my-btn my-btn-confirm" style="text-decoration: none;" href="/pay_qr-customer">QR พร้อมเพย์</a>
      </div>

      <p>ชำระ (<%= total %>)</p>




    </div>

  </div>



  </div>


</body>

</html>
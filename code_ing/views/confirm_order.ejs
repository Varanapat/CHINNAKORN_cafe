<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สรุปรายการ</title>
  <style>
    body {
      font-family: "Arial", sans-serif;
      margin: 0;
      padding: 0;
      background: #f7f7f7;
    }
    .container {
      width: 95%;
      margin: 30px auto;
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      display: flex;
      gap: 20px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      min-height: 70vh;
      margin-top: 5%;
    }
    .order-summary {
      flex: 2;
    }
    .payment {
      flex: 1;
      background: #fcf9f2;
      padding: 15px;
      border-radius: 10px;
    }
    h2 {
      text-align: center;
      margin-bottom: 20px;
    }
    .menu-item {
      display: flex;
      gap: 15px;
      margin-bottom: 15px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 10px;
      /* border: 1px solid seagreen; */
    }
    .menu-item img {
      width: 100px;
      border-radius: 8px;
    }
    .details {
      flex: 1;
    }
    .details {
    display: flex;
    flex-direction: column;
    height: 100%; /* ให้แน่ใจว่า .details มีพื้นที่ */
    }

    .price {
    margin-top: auto; /* ดันให้ชิดล่าง */
    text-align: right;
    font-weight: bold;
    color: #333;
    padding-top: 10px;
    }
    .total-box {
      margin-top: 20px;
      border-top: 2px solid #000;
      padding-top: 10px;
      font-size: 1.2em;
      display: flex;
      justify-content: space-between;
    }
    .total-box_not-final {
      /* margin-top: 20px; */
      /* border-top: 2px solid #000; */
      padding-top: 10px;
      font-size: 1em;
      color: #888;
      display: flex;
      justify-content: space-between;
    }
    .pay-buttons button {
      width: 48%;
      padding: 12px;
      margin-bottom: 10px;
      font-size: 1em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    .cash {
      background: #888;
      color: #fff;
    }
    .qr {
      background: #888;
      color: #fff;
    }
    .amount-buttons button {
      width: 48%;
      padding: 12px;
      margin: 5px 1%;
      border-radius: 8px;
      border: 1px solid #ccc;
      background: #fff;
      cursor: pointer;
    }
    .custom-btn {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #aaa;
      background: #eee;
      cursor: pointer;
    }
    .name_order{
        display: flex;
        justify-content: space-between;
    }
    .header{
        display: flex;
        justify-content: space-between;
        padding: 10px 100px;
        /* border: 1px solid brown; */
        position: fixed; 
        width: 100%;
        /* text-align: center; */
        align-items: center;
        background-color: #ffffff;
        z-index: 10;
        box-shadow: 0 4px 12px #9ba1a7;
        top: 0;
        left: 0;
    }

    .header h2 {
        margin: 0 auto;
        }
    .header a{
        text-decoration: none;
        font-size: 2rem;
        font-weight: 500;
        position: absolute;
        color: #000;
    }
  </style>
</head>
<body>
    <div class="header">
        <a href="/">&#11013;</a>
        <h2>สรุปรายการ ( <%= cart.length %> รายการ )</h2>
    </div>
 
  <div class="container">
    
    <!-- สรุปรายการฝั่งซ้าย -->
    <div class="order-summary">
      <% cart.forEach(item => { %>
      <div class="menu-item">
        <img src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
        <div class="details">
            <div class="name_order">
                <div class="name"><h3><%= item.menu_name %></h3></div>
                <div class="quantity"><%= item.quantity %> X</div>
            </div>
    
            <ul>
            <% if (item.options && item.options.length > 0) { %>
                <% item.options.forEach(opt => { %>
                <li><%= opt.name %><%= opt.extra && opt.extra > 0 ? ` (+${opt.extra})` : "" %></li>
                <% }) %>
            <% } %>
            </ul>
        
          <div class="price"><%= item.totalPrice_forMenu %> ฿</div>
        </div>
      </div>
      <% }) %>
        <% 
            let beforeVAT = (total * 100) / 107;
            let vat = total - beforeVAT;
        %>


      <div class="total-box_not-final">
        <span>ยอดรวมก่อน vat :</span>
       <span><%= beforeVAT.toFixed(2) %> ฿</span>
      </div> 
      <div class="total-box_not-final">
        <span>vat :</span>
       <span><%= vat.toFixed(2) %> ฿</span>
      </div> 
      <div class="total-box">
        <span>ยอดรวม :</span>
        <span><%= total %> ฿</span>
      </div>
    </div>

    <!-- ฝั่งขวา วิธีการชำระเงิน -->
    <div class="payment">
      <h3>วิธีการชำระเงิน</h3>
      <div class="pay-buttons">
        
        <button class="cash">เงินสด</button>
        <!-- <button class="qr">QR พร้อมเพย์</button> -->
        <a href="/pay_qr">QR พร้อมเพย์</a>
      </div>

      <p>ชำระ (<%= total %>)</p>
      <div class="amount-buttons">
        <button><%= total %></button>
        <button>400</button>
        <button>500</button>
        <button>1000</button>
      </div>

      <button class="custom-btn">กำหนดเอง</button>
    </div>
  </div>
</body>
</html>

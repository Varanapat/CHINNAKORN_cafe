<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ข้อมูลการชำระเงิน</title>
    <link rel="stylesheet" href="/style_pay_qr_customer.css">

</head>
<body>
  <div class="header">
        <a href="confirm_order">&#11013;</a>
    </div>
  <div class="page">
    <div class="title">ข้อมูลการชำระเงิน</div>
    <div class="main">
      <!-- QR Code ฝั่งซ้าย -->
      <div class="qr-section">
        <div class="qr-header">THAI QR PAYMENT</div>
        <img src="<%=qr%>" alt="QR Code">
        <div class="amount">฿ <%=amount%></div>
        <div class="company">
          บริษัท ยังไม่มีชื่อ<br>
          
        </div>
        <div class="ref">หมายเลขอ้างอิง : ยังไม่ี</div>

        <div class="payment-info">
          <p>ยอดชำระเงินทั้งหมด <b>฿ <%=amount%></b></p>
          <p>กรุณาชำระภายใน <b>2 นาที</b></p>
          <p>หมดเวลา ยังไม่ได้ทำ ,ยังไม่ได้ใส่</p>
        </div>
      </div>

      <!-- ข้อแนะนำฝั่งขวา -->
      <div class="right-panel">
        <h3>กรุณาทำตามขั้นตอนที่แนะนำ</h3>
        <ol>
          <li>เปิดแอปพลิเคชันธนาคารบนอุปกรณ์ของท่าน</li>
          <li>สแกน QR code ที่อยู่บนหน้าจอ</li>
          <li>กดยืนยัน</li>
          <li>คำสั่งซื้อจะได้รับการยืนยันทันทีหลังจากชำระเงินสำเร็จ</li>
        </ol>
        <div class="note">
          หมายเหตุ: ช่องทางชำระเงินพร้อมเพย์ใช้ได้กับแอปพลิเคชันธนาคารหรือวอลเล็ทที่รองรับการชำระเงินด้วยพร้อมเพย์เท่านั้น
        </div>
      </div>
    </div>

    <!-- ปุ่ม -->
    <div class="btns">
      <a href="/cash-customer/<%=amount%>" class="btn btn-back">สั่งซื้อเสร็จสิ้น</a>
      <a href="/canceled_order-customer" class="btn btn-cancel">ยกเลิกคำสั่งซื้อ</a>
    </div>
  </div>
</body>
<script>
   
    setTimeout(() => {
      window.location.href = "/cash-customer/<%=amount%>";
    }, 3000);
  </script>
</html>

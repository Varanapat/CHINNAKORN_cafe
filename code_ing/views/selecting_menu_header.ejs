<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <header>
        <a href="" class="logo">
            <img src="/picture/icon.PNG" alt="Logo" style="height: 50px;">
        </a>

        <nav>
            <% cate.forEach(item=> { %>
                <a href="#<%= item.category_id %>" class="<%= item.category_id == activeCateId ? 'active' : '' %>">
                    <%= item.category_name %>
                </a>
                <% }); %>
                <!-- <a href="/cart" class="cart">CART</a> -->
        </nav>
        <!-- <span id="cart-count">0</span> -->

    </header>

</body>
</html>
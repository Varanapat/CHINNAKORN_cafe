<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chinakorn Cafe</title>
    <link rel="shortcut icon" href="/pictures/logo.PNG" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style_inventory.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Bungee&family=Cormorant+Unicase:wght@300;400;500;600;700&family=Inknut+Antiqua:wght@300;400;500;600;700;800;900&family=Mitr:wght@200;300;400;500;600;700&family=Noto+Serif+Thai:wght@100..900&family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
        rel="stylesheet">
    <script src="script_inventory.js"></script>
</head>

<style>
    body {
        background: #FBF8F1;
        color: #483434;
        -webkit-overflow-scrolling: touch;
        font-family: Cormorant Unicase;
        font-weight: 800;
    }

    img {
        width: 70px;
        height: 70px;
    }

    h4 {
        margin-top: 10px;
    }

    a {
        text-decoration: none;
        color: #483434;
    }

    .sidebar {
        width: 18%;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background: #fff;
        border-right: 1px solid #ddd;
        padding: 30px;
        z-index: 1000;
    }

    .content {
        margin-left: 18%;
        display: flex;
        flex-direction: row;
        gap: 25px;
        white-space: nowrap;
        flex-wrap: wrap;
    }

    .bartop {
        padding-top: 2%;
        padding-bottom: 2%;
        border-bottom: solid black 2px;
    }

    .chinnakorn {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 5rem;
        color: rgba(0, 0, 0, 0.05);
        pointer-events: none;
        z-index: 0;
        user-select: none;
        white-space: nowrap;
    }
</style>

<body>
    <div class="w-100 h-100">
        <p class="chinnakorn">CHINNAKORN CAFE</p>
        <div class="sidebar">
            <div class="text-center bartop pb-4">
                <a href="/bartender">
                    <h1>
                        <%= data.length %>
                    </h1>
                    <h4>Orders</h4>
                </a>
            </div>
            <div class="bartop text-center py-4">
                <a href="/inventory">
                    <img src="/pictures/package-box.PNG" alt="box">
                    <h4 class="cormorant">Inventory</h4>
                </a>
            </div>
        </div>

        <div class="block">
            <div class="container">
                <!-- Main Content -->
                <div class="main-content">
                    <!-- Left Column -->
                    <div class="product-section">
                        <h2 class="section-title">Inventory</h2>

                        <!-- Search & Category -->
                        <div class="search-bar">
                            <button class="category-btn active" data-category="drinks">Drinks</button>
                            <button class="category-btn" data-category="bakery">Bakery</button>
                            <input type="text" placeholder="Search... 🔎">
                            <i class="fa fa-search"></i>
                        </div>

                        <!-- Drinks Section -->
                        <div id="drinks-section" class="product-grid">
                            <% if (drinks && drinks.length> 0) { %>
                                <% drinks.forEach(item=> { %>
                                    <div class="product-card <%= !item.is_avaliable ? 'unavaliable' : '' %>"
                                        data-id="<%= item.menu_id %>"
                                        onclick="selectItem('<%= item.menu_id %>', '<%= item.menu_name %>', 'drink', '<%= item.is_avaliable %>', '<%= item.stock_qty || 0 %>')">
                                        <img src="/menu_pictures/<%= item.menu_image || 'no_image.png' %>"
                                            alt="<%= item.menu_name %>">
                                        <div class="product-name">
                                            <%= item.menu_name %>

                                        </div>
                                        <div class="price">
                                            <%= item.base_price %> ฿
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="no-products">No Data</div>
                                            <% } %>
                        </div>

                        <!-- Bakery Section -->
                        <div id="bakery-section" class="product-grid" style="display: none;">
                            <% if (bakery && bakery.length> 0) { %>
                                <% bakery.forEach(item=> { %>
                                    <div class="product-card"
                                        onclick="selectItem('<%= item.menu_id %>', '<%= item.menu_name %>', 'bakery', '<%= item.is_avaliable %>','<%= item.stock_qty || 0 %>')">
                                        <img src="/menu_pictures/<%= item.menu_image || 'no_image.png' %>"
                                            alt="<%= item.menu_name %>">
                                        <div class="product-name">
                                            <%= item.menu_name %>
                                        </div>
                                        <div class="price">
                                            <%= item.base_price %> ฿
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="no-products">No Data</div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="selected-section">
                        <h3 class="selected-title">Your Selection</h3>
                        <div class="selected-items" id="selectedItems">
                            <div class="empty-state">
                                <p>Please Select Products</p>
                            </div>
                        </div>
                        <div class="action-buttons">
                            <button class="btn btn-cancel" onclick="clearSelection()">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>
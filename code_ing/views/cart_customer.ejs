<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div class="modal" id="cart-modal">
    <div class="modal-content">
        <span class="close-btn" id="close-modal">&times;</span>
        <h2>ตะกร้าสินค้า</h2>

        <% if (cart.length === 0) { %>
            <p>ยังไม่มีสินค้าในตะกร้า</p>
        <% } else { %>
            <ul id="cart-list">
                <% cart.forEach((item) => { %>
                    <li data-menu-id="<%= item.menu_id %>" data-options='<%= JSON.stringify(item.options) %>'>
                        <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                        <strong><%= item.menu_name %></strong><br>
                        จำนวน: 
                        <button type="button" class="qty-btn minus">&minus;</button>
                        <span class="qty"><%= item.quantity %></span>
                        <button type="button" class="qty-btn plus">&plus;</button>
                        | ราคา/ชิ้น: <%= item.unitPrice %> | รวม: <span class="totalPrice"><%= item.totalPrice_forMenu %></span>
                        <br>
                        ตัวเลือก: 
                        <%= item.options.map(opt => opt.name + (opt.extra && opt.extra > 0 ? ` (+${opt.extra})` : "")).join(" | ") %>
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <a href="/confirm_order">ยืนยันคำสั่งซื้อ</a> | 
        <a href="/canceled_order">ยกเลิกคำสั่งซื้อ</a>
    </div>
</div>
    <script>
const cartIcon = document.getElementById('cart-icon');
const modal = document.getElementById('cart-modal');
const closeBtn = document.getElementById('close-modal');

cartIcon.addEventListener('click', () => {
    modal.style.display = 'flex'; // หรือ block
});
closeBtn.addEventListener('click', () => {
    modal.style.display = 'none';
});
window.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
});

    </script>
</body>
</html>
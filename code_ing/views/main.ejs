<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chinakorn Cafe</title>
    <link rel="shortcut icon" href="/pictures/logo.PNG" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style_main_bartender.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Bungee&family=Cormorant+Unicase:wght@300;400;500;600;700&family=Inknut+Antiqua:wght@300;400;500;600;700;800;900&family=Mitr:wght@200;300;400;500;600;700&family=Noto+Serif+Thai:wght@100..900&family=Prompt:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
        rel="stylesheet">
</head>

<body>
    <p class="chinnakorn">CHINNAKORN CAFE</p>
    <div class="sidebar">
        <div class="text-center bartop pb-4">
            <a href="/bartender">
                <h1 class="cormorant">
                    <% if (data && data.length) { %>
                        <%= data.length %>
                            <% } else { %>
                                0
                                <% } %>
                </h1>
                <h4 class="cormorant">Orders</h4>
            </a>
        </div>
        <div class="bartop text-center py-4">
            <a href="/inventory">
                <img src="/pictures/package-box.PNG" alt="box">
                <h4 class="cormorant">Inventory</h4>
            </a>
        </div>
    </div>

    <div class="container content text-between">
        <% if (data && data.length> 0) { %>
            <% data.forEach(row=> { %>
                <div class="order-card card" data-order-id="<%= row.order_id %>">
                    <div class="card-body order-header">
                        <div class="order-id">
                            <h3>
                                <%= row.order_id %>
                            </h3>
                        </div>
                        <div class="order-time">
                            <h5>
                                <%= row.order_time %>
                            </h5>
                        </div>
                    </div>
                    <div class="card-body order-type">
                        <h5>
                            <%= row.order_type %>
                        </h5>
                    </div>
                    <div class="card-body order-details d-flex flex-column">
                        <% JSON.parse(row.items).forEach(item=> { %>
                            <div class="d-flex">
                                <h6 class="bgqua px-1">
                                    <%= item.quantity %>
                                </h6>
                                <h6 class="menuqua">
                                    <%= item.menu_name %>
                                </h6>
                            </div>
                            <% if (item.option_name) { %>
                                <div class="option-name">
                                    <h6>
                                        <%= item.option_name %>
                                    </h6>
                                </div>
                                <% } %>
                                    <% }) %>
                    </div>
                    <div class="card-footer text-center bg-white p-0 border-0">
                        <button class="btn" onclick="addCompleteListener(this);">Confirm</button>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <% } %>
    </div>




    <script>
        function addCompleteListener(button) {
            // หา card ที่เป็น parent ของปุ่มนี้
            const card = button.closest(".order-card");
            const orderId = card.dataset.orderId;  // สมมติว่าใน HTML ใส่ data-order-id ไว้

            // แสดง pop-up ยืนยัน
            const confirmDelete = confirm("Confirm order completion? Once confirmed, this action cannot be undone.");
            if (confirmDelete) {
                // เรียก API ไปอัปเดตสถานะใน DB
                fetch(`/complete-order/${orderId}`, {
                    method: "POST"
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            card.remove();       // ลบการ์ดออกจาก DOM
                            updateOrderCount();  // อัปเดตจำนวนออเดอร์
                        } else {
                            alert("Failed to update order status!");
                        }
                    })
                    .catch(err => {
                        console.error("Error:", err);
                        alert("Server error!");
                    });
            }
        }

        function updateOrderCount() {
            const countElement = document.querySelector(".sidebar h1");
            const orderCards = document.querySelectorAll(".order-card");
            countElement.textContent = orderCards.length;
        }

        //refresh ทุก 10 วินาที
         setInterval(function () {
            window.location.reload();
        }, 3000);
        console.log("Refresh every 3 seconds");
    </script>


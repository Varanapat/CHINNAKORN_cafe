<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style_cart.css">
</head>
<style>
    body {
  margin: 0;
  font-family: "Prompt", "Sarabun", sans-serif;
  background-color: #fffdf9; /* ครีมอ่อน */
  color: #3b2f2f; /* น้ำตาลเข้ม */
}

/* Header ติดด้านบน */
header.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #ead9cc; /* ครีมเข้ม */
  padding: 10px 20px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* โลโก้แบบหมี + ข้อความ */
.logo-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-bear span {
  font-size: 2rem;
  user-select: none; /* ป้องกันเลือกข้อความ */
}

.header-text h1 {
  margin: 0;
  font-size: 1.6rem;
  font-weight: 700;
  color: #4b2e2b; /* น้ำตาลโกโก้เข้ม */
  letter-spacing: 1px;
  user-select: none;
}

.header-text h2 {
  margin: 0;
  font-size: 0.9rem;
  color: #a3836d; /* น้ำตาลอ่อนทอง */
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  user-select: none;
}

/* เมนูแนวนอน */
nav.vertical-menu {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding: 10px 0;
}

/* ลิงก์เมนู */
nav.vertical-menu a {
  text-decoration: none;
  color: #4b2e2b; /* น้ำตาลเข้ม */
  font-weight: 600;
  padding: 8px 14px;
  border-radius: 20px;
  background-color: transparent;
  transition: background-color 0.2s ease, color 0.2s ease;
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

/* โฮเวอร์ลิงก์เมนู */
nav.vertical-menu a:hover {
  background-color: #d4b8a5; /* น้ำตาลนวลตอน hover */
  color: #3b2f2f;
}

/* เมนูที่ active */
nav.vertical-menu a.active {
  background-color: #c2a18a; /* น้ำตาลนวลเข้ม */
  color: #fffaf5; /* สีครีมอ่อน */
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* สำหรับ scrollbar แบบนวล ๆ บน nav */
nav.vertical-menu::-webkit-scrollbar {
  height: 6px;
}

nav.vertical-menu::-webkit-scrollbar-thumb {
  background-color: #c2a18a;
  border-radius: 10px;
}

nav.vertical-menu::-webkit-scrollbar-track {
  background-color: transparent;
}

/* Responsive: เมนูเล็กลงบนมือถือ */
@media (max-width: 480px) {
  header.sticky-header {
    flex-direction: column;
    align-items: flex-start;
  }

  nav.vertical-menu {
    gap: 8px;
    padding: 6px 0;
  }

  nav.vertical-menu a {
    padding: 6px 12px;
    font-size: 0.9rem;
  }
  /* ปุ่มยืนยันและยกเลิกคำสั่งซื้อ */
a.button {
  display: block;
  width: 200px;
  max-width: 90vw;
  margin: 12px auto;
  padding: 12px 0;
  text-align: center;
  text-decoration: none;
  font-weight: 700;
  font-size: 1.1rem;
  border-radius: 8px;
  cursor: pointer;
  user-select: none;
  transition: background-color 0.3s ease, color 0.3s ease;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* ปุ่มยืนยัน */
a.button.confirm {
  background-color: #a17c6b; /* น้ำตาลเข้มกลาง */
  color: #fffaf5; /* ครีมอ่อน */
  border: 2px solid #8f6c5a;
}

a.button.confirm:hover {
  background-color: #8f6c5a;
  border-color: #7a5a49;
}

/* ปุ่มยกเลิก */
a.button.cancel {
  background-color: #f4e9dc; /* ครีมอ่อน */
  color: #7a5a49; /* น้ำตาลอ่อน */
  border: 2px solid #c2a18a;
}

a.button.cancel:hover {
  background-color: #e0d4c3;
  color: #5c4333;
  border-color: #a3876b;
}

}


</style>

<body>
<h1>ตะกร้าสินค้า</h1>


<% if (cart.length === 0) { %>
  <p>ยังไม่มีสินค้าในตะกร้า</p>
<% } else { %>
    <ul id="cart-list">
        <% cart.forEach((item, index) => { %>
            <li data-menu-id="<%= item.menu_id %>" data-options='<%= JSON.stringify(item.options) %>'>
                <img class="img" src="/picture/<%= item.menu_image %>" alt="<%= item.menu_name %>">
                <strong><%= item.menu_name %></strong><br>
                จำนวน: 
                <button type="button" class="qty-btn minus">&minus;</button>
                <span class="qty"><%= item.quantity %></span>
                <button type="button" class="qty-btn plus">&plus;</button>
                | ราคา/ชิ้น: <%= item.unitPrice %> | รวม: <span class="totalPrice"><%= item.totalPrice_forMenu %></span>
                <br>
                ตัวเลือก: 
                <%= item.options.map(opt => opt.name + (opt.extra && opt.extra > 0 ? ` (+${opt.extra})` : "")).join(" | ") %>
            </li>
        <% }) %>
    </ul>
    <!-- <p>รวมทั้งหมด: <span id="cart-total"><%= total %></span> บาท</p> -->


<% } %>
<a href="/confirm_order"><button>ยืนยันคำสั่งซื้อ</button></a>
<a href="/canceled_order"><button>ยกเลิกคำสั่งซื้อ</button></a>



               
<script src="/script_cart.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chinakorn Cafe</title>
    <link rel="shortcut icon" href="/pictures/logo.PNG" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<style>
    body {
        background: #FBF8F1;
        font-family: 'Prompt', sans-serif;
        color: #483434;
        -webkit-overflow-scrolling: touch;
    }

    img {
        width: 70px;
        height: 70px;
    }

    h4 {
        margin-top: 10px;
    }

    a {
        text-decoration: none;
        color: #483434;
    }

    .sidebar {
        width: 18%;
        background: #fff;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        border-right: 1px solid #ddd;
        padding: 30px;
    }

    .bartop {
        padding-top: 2%;
        padding-bottom: 2%;
        border-bottom: solid black 2px;
    }
</style>

<body>
    <div class="sidebar">
        <div class="text-center bartop pb-4">
            <a href="/">
                <h1>
                    <%= data.length %>
                </h1>
                <h4>Orders</h4>
            </a>
        </div>
        <div class="bartop text-center py-4">
            <a href="/inventory">
                <img src="/pictures/package-box.PNG" alt="box">
                <h4>Inventory</h4>
            </a>
        </div>
    </div>
</body>

</html>